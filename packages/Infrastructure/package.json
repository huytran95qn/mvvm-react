{
    "name": "@mvvm-react/infrastructure",
    "version": "0.1.0",
    "description": "Infrastructure library project for mvvm-react",
    "license": "MIT",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:clean": "rm -rf dist && rm -f tsconfig.build.tsbuildinfo",
        "build:project": "pnpm run build:clean && tsc -p tsconfig.build.json",
        "build": "pnpm run build:project",
        "release": "pnpm run build",
        "dev": "tsc -p tsconfig.build.json --watch"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "reflect-metadata": "^0.2.0"
    },
    "dependencies": {
        "inversify": "^7.10.4",
        "rxjs": "^7.8.1"
    }
}