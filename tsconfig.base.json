{
  "compilerOptions": {
	"target": "ES2019",
	"module": "ESNext",
	"lib": ["ES2019", "DOM"],
	"moduleResolution": "Bundler",
	"strict": true,
	"skipLibCheck": true,
	"esModuleInterop": true,
	"forceConsistentCasingInFileNames": true,
	"resolveJsonModule": true,
	"allowSyntheticDefaultImports": true,
	"noEmit": false,
	"isolatedModules": true,
	"baseUrl": "./",
	"experimentalDecorators": true,
	"emitDecoratorMetadata": true,
	"paths": {
		"@Components": ["packages/Components/src/index.ts"],
		"@Utils/*": ["packages/Utils/src/*"],
		"@Core": ["packages/Core/src"],
		"@Repositories/*": ["packages/Infrastructure/src/Repositories/*"],
		"@Domain/Entities/*": ["packages/Domain/Entities/*"],
		"@Domain/Repositories/*": ["packages/Domain/Repositories/*"],
		"@Application/*": ["packages/Application/src/*"]
	}
  }
}
